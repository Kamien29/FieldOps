{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "entrypoint": "api/handler.js"
    },
    "fieldops-web": {
      "root": "fieldops-web",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend",
        "path": "/api/handler"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "fieldops-web"
      }
    }
  ]
}
