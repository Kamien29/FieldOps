{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd fieldops-web && npm ci",
  "buildCommand": "cd fieldops-web && npm run build",
  "outputDirectory": "fieldops-web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://TWOJ-BACKEND.example.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}